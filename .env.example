# Copia a .env y rellena. NUNCA subir .env al repo (es público).

# Base de datos propia de la app
DATABASE_URL="postgresql://fixartebcn_user:CAMBIAR@localhost:5432/fixartebcn_db?schema=public"

# Sesiones del panel (/panel) — cadena aleatoria larga
AUTH_SECRET="CAMBIAR_32_CHARS_ALEATORIOS"

# Email transaccional (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="FixArte BCN <fixartebcn@olcas.app>"

# Dominio público: se usa en canonical, sitemap, OG y en el enlace de reseñas
SITE_URL="https://fixartebcn.es"
PORT="4008"

# Carpeta persistente de fotos y vídeos subidos desde el panel
UPLOADS_DIR="/var/www/fixartebcn/uploads"

# Solo para el seed inicial (primer usuario del panel)
ADMIN_EMAIL="contacto@fixartebcn.es"
ADMIN_PASSWORD="CAMBIAR"

# Requisito del servidor: ffmpeg y ffprobe instalados (recodificación de vídeo)
