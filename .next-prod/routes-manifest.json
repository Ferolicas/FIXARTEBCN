{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/consejos/[slug]",
      "regex": "^/consejos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/consejos/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/panel/consejos/[id]",
      "regex": "^/panel/consejos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/panel/consejos/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/panel/servicios/[id]",
      "regex": "^/panel/servicios/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/panel/servicios/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/panel/trabajos/[id]",
      "regex": "^/panel/trabajos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/panel/trabajos/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/servicios/[slug]",
      "regex": "^/servicios/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/servicios/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/uploads/[...path]",
      "regex": "^/uploads/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/uploads/(?<nxtPpath>.+?)(?:/)?$"
    }
  ],
