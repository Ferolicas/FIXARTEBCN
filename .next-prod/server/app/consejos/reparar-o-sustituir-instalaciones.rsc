1d:[["$","h2",null,{"children":"¿Qué son las cookies?"}],["$","p",null,{"children":"Las cookies son pequeños archivos que se almacenan en tu dispositivo al visitar un sitio web y que permiten su funcionamiento o recopilan información sobre tu navegación."}],["$","h2",null,{"children":"Cookies que utiliza este sitio"}],["$","p",null,{"children":[["$","strong",null,{"children":"fixartebcn.es no utiliza cookies publicitarias ni de rastreo."}]," Únicamente empleamos cookies técnicas estrictamente necesarias:"]}],["$","ul",null,{"children":["$","li",null,{"children":[["$","strong",null,{"children":"Cookies de sesión del área de administración:"}]," se instalan solo si accedes al panel de gestión del sitio (área privada del propietario) y sirven para mantener la sesión iniciada."]}]}],["$","p",null,{"children":"Las cookies técnicas imprescindibles no requieren consentimiento según la normativa vigente (art. 22.2 LSSI-CE), por lo que este sitio no muestra banner de cookies."}],["$","h2",null,{"children":"Servicios de terceros enlazados"}],["$","p",null,{"children":"Este sitio contiene enlaces a servicios de terceros (WhatsApp, Google Maps, redes sociales). Al acceder a ellos, se aplican las políticas de cookies y privacidad de dichos servicios."}],["$","h2",null,{"children":"Cambios en esta política"}],["$","p",null,{"children":"Si en el futuro incorporamos servicios que instalen cookies adicionales (por ejemplo, analítica o vídeo incrustado), actualizaremos esta política y, cuando sea necesario, solicitaremos tu consentimiento mediante un banner de gestión de cookies."}]]
