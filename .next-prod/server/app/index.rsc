29:["$","ul",null,{"className":"mt-7 inline-grid gap-2 rounded-2xl bg-white/40 px-5 py-4 backdrop-blur-sm sm:grid-cols-[auto_auto] sm:gap-x-6","children":[["$","li","0",{"className":"flex items-center gap-2 text-[15.4px] font-semibold text-black ","children":[["$","span",null,{"aria-hidden":true,"className":"gold-rule h-1.5 w-1.5 shrink-0 rounded-full"}],["Presupuesto cerrado por escrito, ",["$","strong",null,{"className":"font-bold","children":"sin sorpresas"}]]]}],["$","li","1",{"className":"flex items-center gap-2 text-[15.4px] font-semibold text-black ","children":[["$","span",null,{"aria-hidden":true,"className":"gold-rule h-1.5 w-1.5 shrink-0 rounded-full"}],["Urgencias ",["$","strong",null,{"className":"font-bold","children":"24 h"}]]]}],["$","li","2",{"className":"flex items-center gap-2 text-[15.4px] font-semibold text-black sm:col-span-2","children":[["$","span",null,{"aria-hidden":true,"className":"gold-rule h-1.5 w-1.5 shrink-0 rounded-full"}],"Barcelona · Badalona · Área metropolitana"]}]]}]
2a:["$","div",null,{"className":"hidden lg:block","children":["$","$L32",null,{"services":[{"slug":"electricista-barcelona","title":"Electricidad","icon":"bolt","shortDesc":"Instalación y reparación de puntos de luz, enchufes, cuadros eléctricos, iluminación LED y averías eléctricas.","bullets":["Reparación de averías eléctricas","Cuadros eléctricos y diferenciales","Puntos de luz, enchufes e interruptores","Iluminación LED y bajo consumo","Detectores de presencia","Revisión y mantenimiento de instalaciones"]},{"slug":"fontanero-barcelona","title":"Fontanería","icon":"droplet","shortDesc":"Fugas, grifos, sanitarios, desagües y atascos. Reparaciones e instalaciones de fontanería con garantía.","bullets":["Reparación de fugas de agua","Desatascos de tuberías y desagües","Sustitución de grifos y sanitarios","Instalación de lavabos y fregaderos","Termos y calentadores","Pequeñas reformas de fontanería"]},{"slug":"pintores-barcelona","title":"Pintura","icon":"paint","shortDesc":"Pintura interior y exterior, reparación de paredes, tratamiento de humedades y acabados de alta calidad.","bullets":["Pintura de pisos y casas","Pintura de locales y oficinas","Alisado de paredes y quitar gotelé","Tratamiento de humedades y antimoho","Reparación de grietas y desperfectos","Esmaltes en puertas, radiadores y metal"]}],"phone":"+34634390345","phoneDisplay":"+34 634 39 03 45","whatsapp":"34634390345"}]}]
2b:["$","section",null,{"id":"servicios","className":"anchor container-site py-16 sm:py-24","children":[["$","div",null,{"className":"max-w-2xl mx-auto text-center","children":[["$","p",null,{"className":"slash-label mb-3","children":"Nuestros servicios"}],["$","h2",null,{"className":"text-3xl sm:text-4xl","children":"Todo lo que tu hogar o negocio necesita"}],["$","p",null,{"className":"mt-4 text-lg leading-relaxed text-ink-700","children":"Soluciones integrales de mantenimiento, reparación e instalación para viviendas, locales, oficinas y comunidades. Profesionalidad, materiales de calidad y precio cerrado."}]]}],["$","div",null,{"className":"mt-12","children":["$","$L33",null,{"services":[{"slug":"electricista-barcelona","title":"Electricidad","icon":"bolt","shortDesc":"Instalación y reparación de puntos de luz, enchufes, cuadros eléctricos, iluminación LED y averías eléctricas.","bullets":"$2a:props:children:props:services:0:bullets","faqs":[{"a":"Sí. Evaluamos la avería o el trabajo, te damos un presupuesto claro y sin compromiso y solo empezamos cuando lo apruebas.","q":"¿Hacéis presupuesto antes de empezar el trabajo?"},{"a":"Las averías eléctricas se atienden con prioridad. Escríbenos por WhatsApp o llámanos y te confirmamos la franja de visita más rápida disponible en Barcelona, Badalona o el área metropolitana.","q":"Se me va la luz y salta el diferencial, ¿podéis venir hoy?"},{"a":"Sí. Sustituimos cuadros antiguos por cuadros modernos con protecciones actuales (diferenciales y magnetotérmicos), dejando la instalación más segura y preparada para el consumo real de la vivienda.","q":"¿Podéis cambiar un cuadro eléctrico antiguo?"},{"a":"Sí. Mantenemos la iluminación de escaleras, portales y garajes, instalamos detectores de presencia y resolvemos averías en zonas comunes.","q":"¿Trabajáis para comunidades de propietarios?"}]},{"slug":"fontanero-barcelona","title":"Fontanería","icon":"droplet","shortDesc":"Fugas, grifos, sanitarios, desagües y atascos. Reparaciones e instalaciones de fontanería con garantía.","bullets":"$2a:props:children:props:services:1:bullets","faqs":[{"a":"Cierra la llave de paso general de la vivienda (suele estar en la cocina, el baño o la entrada) y contáctanos por teléfono o WhatsApp. Te daremos la franja de visita más rápida posible.","q":"Tengo una fuga de agua, ¿qué hago mientras llegáis?"},{"a":"Te damos presupuesto claro antes de intervenir. Cuéntanos el problema por WhatsApp —si puedes, con una foto o vídeo— y te orientamos sin compromiso.","q":"¿Cobráis por venir a ver la avería?"},{"a":"Sí. Desatascamos fregaderos, lavabos, duchas e inodoros, y también bajantes y colectores de comunidades.","q":"¿Desatascáis tuberías y bajantes?"},{"a":"Sí, instalamos material aportado por el cliente. Si lo prefieres, también te lo suministramos nosotros con garantía del fabricante.","q":"¿Instaláis la grifería o el sanitario si ya lo he comprado?"}]},{"slug":"pintores-barcelona","title":"Pintura","icon":"paint","shortDesc":"Pintura interior y exterior, reparación de paredes, tratamiento de humedades y acabados de alta calidad.","bullets":"$2a:props:children:props:services:2:bullets","faqs":[{"a":"Sí, salvo que prefieras aportar tú la pintura. El presupuesto detalla mano de obra, materiales y plazos, cerrado antes de empezar.","q":"¿El presupuesto incluye la pintura y los materiales?"},{"a":"Un piso medio (70–90 m²) suele estar listo en 3 a 5 días laborables, según el estado de las paredes y si hay alisado o reparaciones previas.","q":"¿Cuánto se tarda en pintar un piso?"},{"a":"Siempre. Identificamos el origen (condensación, filtración o capilaridad), lo tratamos y aplicamos productos específicos antes del acabado. Pintar encima sin tratar solo esconde el problema unas semanas.","q":"¿Tratáis las manchas de humedad antes de pintar?"},{"a":"Sí. Cubrimos suelos, muebles y carpinterías con plásticos y cartón, y al terminar dejamos el espacio limpio y listo para usar.","q":"¿Protegéis los muebles y el suelo?"}]},{"slug":"pladur-barcelona","title":"Pladur y tabiquería","icon":"wall","shortDesc":"Tabiques, falsos techos, cajones de pladur y adecuación de espacios con acabados perfectos.","bullets":["Tabiques divisorios con aislamiento","Falsos techos continuos y registrables","Cajones para ocultar instalaciones","Trasdosados de paredes","Hornacinas y estanterías de obra","Reparación de placas y grietas"],"faqs":[{"a":"Con la configuración adecuada, sí. Combinamos placas con lana de roca u otros aislantes para mejorar notablemente el aislamiento acústico entre estancias.","q":"¿El pladur aísla bien del ruido?"},{"a":"Sí, usando tacos específicos para placa de yeso o reforzando el interior del tabique en la zona de carga. Si sabemos de antemano qué vas a colgar, dejamos el refuerzo preparado.","q":"¿Se puede colgar una televisión o estanterías en un tabique de pladur?"},{"a":"Un tabique estándar de una habitación suele completarse en 1 o 2 días, incluyendo encintado y acabado listo para pintar.","q":"¿Cuánto se tarda en montar un tabique?"},{"a":"Es un sistema de construcción en seco: mucho más rápido y limpio que la obra tradicional. Protegemos la zona de trabajo y retiramos los restos al terminar.","q":"¿Genera mucha obra y suciedad?"}]},{"slug":"carpinteria-barcelona","title":"Carpintería","icon":"hammer","shortDesc":"Instalación y ajuste de puertas, armarios, estanterías y todo tipo de trabajos de carpintería.","bullets":["Instalación y ajuste de puertas","Armarios empotrados y vestidores","Estanterías y almacenaje a medida","Cambio de manillas y bisagras","Zócalos y molduras","Reparaciones de carpintería"],"faqs":[{"a":"Sí, casi siempre. Ajustamos bisagras, cepillamos la hoja o la recolocamos según el caso. Es una intervención rápida y económica.","q":"Mi puerta roza con el suelo, ¿tiene arreglo?"},{"a":"Montamos soluciones de almacenaje a medida con sistemas modulares de calidad y adaptamos armarios existentes. Para ebanistería artesanal compleja te orientamos sobre la mejor opción.","q":"¿Hacéis muebles a medida?"},{"a":"Sí. Si los marcos están en buen estado, sustituimos únicamente las hojas: renovación completa del piso en uno o dos días y sin obras.","q":"¿Podéis cambiar solo las puertas sin obra?"},{"a":"Sí, tanto sistemas vistos como encastados tipo casoneto (la puerta se esconde dentro del tabique), ideales para ganar espacio.","q":"¿Instaláis puertas correderas?"}]},{"slug":"montaje-muebles-barcelona","title":"Montaje de muebles","icon":"sofa","shortDesc":"Montamos tus muebles de IKEA o de cualquier marca: rápido, sin daños y con todo anclado y nivelado.","bullets":["Muebles de IKEA y cualquier marca","Armarios, camas y sofás","Estanterías y escritorios","Anclaje seguro a la pared","Mobiliario de oficina","Desmontaje y montaje en mudanzas"],"faqs":[{"a":"Depende del tipo y tamaño del mueble. Envíanos por WhatsApp la referencia o una foto de la caja y te damos precio cerrado al momento.","q":"¿Cuánto cuesta montar un mueble?"},{"a":"Sí, es de lo que más montamos: armarios PAX con puertas correderas o batientes, interiores KOMPLEMENT y anclaje a pared incluido.","q":"¿Montáis muebles PAX o armarios grandes de IKEA?"},{"a":"Dejamos el embalaje plegado y listo para el punto de reciclaje. Si necesitas que lo retiremos, indícalo al pedir el presupuesto.","q":"¿Os lleváis el embalaje al terminar?"},{"a":"Sí. Desmontamos en origen, embalamos la tornillería identificada y volvemos a montar en destino, dejando cada mueble firme y nivelado.","q":"¿Hacéis desmontaje y montaje para mudanzas?"}]},{"slug":"instalacion-cocinas-barcelona","title":"Instalación de cocinas","icon":"kitchen","shortDesc":"Montaje completo de cocinas: muebles, encimera, electrodomésticos, fontanería y electricidad.","bullets":["Cocinas IKEA (METOD) y otras marcas","Nivelación y montaje de muebles","Encimeras y zócalos","Conexión de agua y desagües","Conexión de placa, horno y campana","Iluminación de cocina"],"faqs":[{"a":"Sí, instalamos el sistema METOD completo: estructura, frentes, encimera, fregadero, grifo y electrodomésticos, con las conexiones incluidas.","q":"¿Instaláis cocinas de IKEA?"},{"a":"Una cocina estándar suele instalarse en 2 a 4 días laborables, según metros, tipo de encimera y estado de las instalaciones existentes.","q":"¿Cuánto se tarda en montar una cocina?"},{"a":"Sí, es nuestra gran ventaja: el mismo equipo realiza las tomas de agua, desagües y conexiones eléctricas necesarias, con materiales homologados.","q":"¿Hacéis también la parte de agua y electricidad?"},{"a":"La conexión de aparatos a gas debe realizarla una empresa habilitada de gas. Nosotros dejamos preparada la cocina y te orientamos para esa conexión; el resto de electrodomésticos los conectamos nosotros.","q":"¿Conectáis electrodomésticos de gas?"}]},{"slug":"reparaciones-hogar-barcelona","title":"Reparaciones del hogar","icon":"wrench","shortDesc":"Un profesional de confianza para todas esas reparaciones pendientes: rápido, limpio y bien hecho.","bullets":["Reparación de persianas","Colgar cuadros, lámparas y TV","Cambio de silicona en baño y cocina","Ajuste de puertas y ventanas","Pequeñas reparaciones eléctricas","Pequeñas reparaciones de fontanería"],"faqs":[{"a":"Sí, y es lo más rentable: agrupamos toda tu lista en una visita con un único desplazamiento. Envíanosla por WhatsApp y te damos precio cerrado.","q":"¿Puedo agrupar varias reparaciones pequeñas en una sola visita?"},{"a":"Sí: cambio de cintas, lamas rotas, ejes y recogedores. Si la persiana no tiene arreglo, te proponemos la sustitución con presupuesto previo.","q":"¿Reparáis persianas?"},{"a":"Sí. Fijamos el soporte adecuado al tipo de pared y, si lo deseas, ocultamos el cableado con canaleta o empotrado.","q":"¿Coláis una TV en la pared con la instalación oculta?"},{"a":"Sí, con horarios flexibles para no interrumpir tu actividad, incluidos primeros turnos de mañana.","q":"¿Dais servicio a tiendas y oficinas?"}]},{"slug":"mantenimiento-comunidades-barcelona","title":"Mantenimiento de comunidades","icon":"building","shortDesc":"Mantenimiento preventivo y correctivo para comunidades de propietarios, edificios y empresas.","bullets":["Electricidad de zonas comunes","Fontanería y bajantes","Pintura de escaleras y portales","Reparaciones y albañilería menor","Atención de urgencias","Partes de trabajo documentados"],"faqs":[{"a":"Sí, es parte esencial de nuestro servicio: canal directo con el administrador, presupuestos rápidos, partes de trabajo con fotos y facturación clara por comunidad.","q":"¿Trabajáis con administradores de fincas?"},{"a":"Sí, planes preventivos con visitas periódicas y condiciones preferentes en reparaciones, adaptados al tamaño y necesidades de cada finca o empresa.","q":"¿Ofrecéis contratos de mantenimiento?"},{"a":"Sí. Las incidencias que afectan a servicios esenciales de la finca (agua, luz de zonas comunes, filtraciones) se atienden con prioridad.","q":"¿Atendéis urgencias en comunidades?"},{"a":"Siempre: factura, parte de trabajo y, cuando aplica, reportaje fotográfico del antes y el después para la comunidad o el administrador.","q":"¿Emitís factura y documentación de cada intervención?"}]},{"slug":"reformas-barcelona","title":"Reformas","icon":"ruler","shortDesc":"Reformas parciales de baños, cocinas y estancias, y adecuación de locales comerciales.","bullets":["Reforma de baños","Cambio de bañera por ducha","Reforma de cocinas","Renovación de estancias","Adecuación de locales comerciales","Coordinación integral de oficios"],"faqs":[{"a":"Depende de los metros, calidades y alcance del cambio. Tras una visita técnica gratuita te entregamos un presupuesto cerrado por partidas, sin sorpresas.","q":"¿Cuánto cuesta reformar un baño?"},{"a":"Normalmente entre 2 y 4 días laborables, incluyendo retirada de la bañera, plato nuevo, alicatado de la zona y mampara.","q":"¿Cuánto se tarda en cambiar una bañera por un plato de ducha?"},{"a":"Sí. Coordinamos albañilería, fontanería, electricidad, pladur, carpintería y pintura con un único interlocutor y un calendario claro.","q":"¿Os encargáis de todos los gremios?"},{"a":"Te orientamos sobre qué permisos requiere tu reforma según el municipio y te ayudamos con la documentación técnica necesaria.","q":"¿Gestionáis los permisos de obra?"}]}],"phone":"+34634390345","phoneDisplay":"+34 634 39 03 45","whatsapp":"34634390345"}]}]]}]
