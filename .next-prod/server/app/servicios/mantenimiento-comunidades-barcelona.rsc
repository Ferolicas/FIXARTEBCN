32:T474,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"¿Trabajáis con administradores de fincas?","acceptedAnswer":{"@type":"Answer","text":"Sí, es parte esencial de nuestro servicio: canal directo con el administrador, presupuestos rápidos, partes de trabajo con fotos y facturación clara por comunidad."}},{"@type":"Question","name":"¿Ofrecéis contratos de mantenimiento?","acceptedAnswer":{"@type":"Answer","text":"Sí, planes preventivos con visitas periódicas y condiciones preferentes en reparaciones, adaptados al tamaño y necesidades de cada finca o empresa."}},{"@type":"Question","name":"¿Atendéis urgencias en comunidades?","acceptedAnswer":{"@type":"Answer","text":"Sí. Las incidencias que afectan a servicios esenciales de la finca (agua, luz de zonas comunes, filtraciones) se atienden con prioridad."}},{"@type":"Question","name":"¿Emitís factura y documentación de cada intervención?","acceptedAnswer":{"@type":"Answer","text":"Siempre: factura, parte de trabajo y, cuando aplica, reportaje fotográfico del antes y el después para la comunidad o el administrador."}}]}6:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Inicio\",\"item\":\"http://localhost:3100/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Servicios\",\"item\":\"http://localhost:3100/servicios\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Mantenimiento de comunidades\",\"item\":\"http://localhost:3100/servicios/mantenimiento-comunidades-barcelona\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Mantenimiento de comunidades en Barcelona\",\"description\":\"Mantenimiento integral de comunidades de propietarios en Barcelona: electricidad, fontanería, pintura y u